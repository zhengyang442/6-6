# 通义千问 API Key（阿里云百炼平台）
# 获取地址：https://dashscope.console.aliyun.com/
TONGYI_API_KEY=

# DeepSeek API Key（备用 AI 出题）
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 服务端口
PORT=8888

# 在线 PK 参数
ONLINE_ROUND_TIME_MS=3000
ONLINE_MATCH_START_DELAY_MS=2000
ONLINE_MAX_ROUNDS=20

# AI 调用超时 (秒)
AI_TIMEOUT_SECONDS=10

# 日志级别
LOG_LEVEL=INFO
